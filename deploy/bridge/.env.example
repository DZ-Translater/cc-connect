# Copy to .env in the same directory, then replace all placeholder values.
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_BASE_URL=https://anthropic-compatible.example.com
# Required: this is the Claude default and the first entry in config.toml's
# strict model allowlist. Add any additional models in config.toml.
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://openai-compatible.example.com/v1
# Required: this is the Codex default and the first entry in config.toml's
# strict model allowlist. Add any additional models in config.toml.
CODEX_MODEL=gpt-5.3-codex
# Third-party Codex endpoint protocol: normally "responses"; use "chat" only
# when the upstream explicitly supports Chat Completions but not Responses.
CODEX_WIRE_API=responses
CC_BRIDGE_TOKEN=replace-with-a-long-random-secret

# Published by .github/workflows/docker-bridge.yml on the dianzhan branch.
# Replace the placeholder with the immutable image@sha256 reference from the
# successful GitHub Actions run. Do not deploy the mutable latest tag.
# CC_CONNECT_IMAGE=ghcr.io/dz-translater/cc-connect-bridge@sha256:<64-hex-digest>

# Bind to loopback when a local reverse proxy owns TLS. Use 0.0.0.0 only when
# the Docker host firewall and network boundary are intentionally configured.
BRIDGE_BIND_ADDR=127.0.0.1
BRIDGE_PORT=9810

# Host directories. Relative paths are resolved from the deployment directory.
DIANZHAN_WORKSPACE=./workspaces/dianzhan
SKILLS_DIR=./skills
