# Copy to deploy/bridge/.env, then replace all placeholder values.
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
CC_BRIDGE_TOKEN=replace-with-a-long-random-secret

# Published by .github/workflows/docker-bridge.yml on the dianzhan branch.
CC_CONNECT_IMAGE=yzg963/cc-connect-bridge:latest

# Bind to loopback when a local reverse proxy owns TLS. Use 0.0.0.0 only when
# the Docker host firewall and network boundary are intentionally configured.
BRIDGE_BIND_ADDR=127.0.0.1
BRIDGE_PORT=9810

# Host directories. Relative paths are resolved from the repository root.
DIANZHAN_WORKSPACE=./deploy/bridge/workspaces/dianzhan
SKILLS_DIR=./deploy/bridge/skills
